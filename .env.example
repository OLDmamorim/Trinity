# Copia para .env (local) ou define no Railway (Variables). Nunca faças commit do .env.

# Acesso à app
TRINITY_PASSWORD=escolhe-uma-palavra-passe-forte
# Opcional: se não definires, a app gera um e guarda-o no volume
# TRINITY_SESSION_SECRET=

# Claude (console.anthropic.com)
ANTHROPIC_API_KEY=
# Opcional: modelo e esforço
# TRINITY_MODEL=claude-opus-5-5
# TRINITY_EFFORT=medium

# Voz (transcrição, OpenAI)
OPENAI_API_KEY=

# PoweringEG: URL da plataforma e chave da API externa com a permissão "assistente"
POWERING_URL=https://o-teu-powering.up.railway.app
POWERING_API_KEY=

# Notificações push: opcional. Sem estas chaves, a app gera-as uma vez e guarda-as no volume.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_CONTACT=mailto:o-teu-email@gmail.com

# Google Calendar (opcional): cliente OAuth do Google Cloud, tipo "Aplicação Web".
# URI de redirecionamento autorizado: <endereço da app>/api/google/retorno
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Endereço público da app (no Railway é detetado sozinho)
# TRINITY_URL=https://trinity-production-xxxx.up.railway.app

# Briefing da manhã (cron, hora de Lisboa). Por omissão: 8h, segunda a sexta.
# BRIEFING_CRON=0 8 * * 1-5

# Pasta da base de dados (no Railway, um volume montado em /data)
DATA_DIR=./dados

# Emails da Trinity ao Marco (Resend, a mesma chave do PoweringEG)
# RESEND_API_KEY=
# EMAIL_FROM=Trinity <noreply@poweringeg.pt>
# EMAIL_PARA=
